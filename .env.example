# URL canônica. Em desenvolvimento local, mantenha localhost; em Production,
# configure a URL HTTPS pública diretamente na Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: tokens públicos de verificação, somente quando as propriedades forem verificadas.
# Exemplo de valor: <google-search-console-token> ou <bing-webmaster-tools-token>.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Opcional: data real da última mudança pública, no formato YYYY-MM-DD (ex.: 2026-07-28).
NEXT_PUBLIC_CONTENT_LAST_MODIFIED=

# Opcional e privado: use somente em .env.local quando necessário e na Vercel Production.
# Exemplo de valor: <private-indexnow-key>. Não use um placeholder como chave real.
INDEXNOW_KEY=
